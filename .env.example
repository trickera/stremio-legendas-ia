# Copie pra .env e preencha.
# Chave Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Chave OpenSubtitles (crie um "API consumer"): https://www.opensubtitles.com/consumers
OS_API_KEY=
# Opcional, mas recomendado: sem login a cota de download diaria e bem baixa.
OS_USERNAME=
OS_PASSWORD=

# So pra expor fora do PC (no Render os dois ja vem prontos pelo render.yaml)
# PUBLIC_URL=https://seu-app.onrender.com
# ADDON_SECRET=uma-string-longa-aleatoria

# Defaults (pode deixar comentado)
# GEMINI_MODEL=gemini-3.1-flash-lite
# SOURCE_LANG=en
# TARGET_LANG=Brazilian Portuguese
# TARGET_LANG_CODE=pob
# PORT=7000
